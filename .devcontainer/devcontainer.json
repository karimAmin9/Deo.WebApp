{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0", // Hier zu Version 9.0.0 das sollte es beheben
	"postCreateCommand": "dotnet restore --locked-mode && dotnet dev-certs https",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"SonarSource.sonarlint-vscode",
				"humao.rest-client"
			]
		}
	}
}